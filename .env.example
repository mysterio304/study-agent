# Copy to .env and fill in. NEVER commit .env. NEVER paste these values into chat.

# --- Telegram (create a bot with @BotFather; get your numeric id from @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# --- Canvas (Account → Settings → New Access Token). Read-only use is enforced in code. ---
CANVAS_BASE_URL=https://canvas.cityu.edu.hk
CANVAS_TOKEN=
CANVAS_POLL_MINUTES=12

# --- ElevenLabs (Milestone 4) ---
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=
ELEVENLABS_VOICE_ID=              # free plan: use a premade voice (library voices need a paid plan)
TTS_DAILY_CHAR_LIMIT=3000

# --- Anthropic ---
ANTHROPIC_API_KEY=
CHEAP_MODEL=claude-haiku-5-5      # default model
SMART_MODEL=claude-sonnet-5-5     # escalations only
CACHE_TTL=5m                      # 5m | 1h — see /usage cache

# --- Behaviour (defaults; cap/window can later be changed by talking to the agent) ---
TZ=Asia/Hong_Kong
DAILY_STUDY_CAP_HOURS=6.5
FINAL_WEEK_CAP_HOURS=8.5
BETWEEN_EXAMS_CAP_HOURS=7.5
STUDY_WINDOW=09:00-23:00
QUIET_HOURS=00:30-08:00
MORNING_DIGEST_TIME=08:30
EVENING_CHECKIN_TIME=21:30
AUTONOMY_MODE=small_auto
MAX_AGENT_STEPS=8
DAILY_LLM_BUDGET_USD=2.0
LLM_BUDGET_WARN_PCT=80

# --- Storage ---
DATABASE_URL=sqlite+aiosqlite:///data/agent.db
LOG_LEVEL=INFO
